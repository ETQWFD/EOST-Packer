<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/settings_bg">
    <LinearLayout android:orientation="vertical"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="12dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/settings_group_ai" android:textSize="12sp"
            android:textColor="#FF5F6368" android:layout_marginTop="8dp"
            android:layout_marginStart="8dp"/>
        <LinearLayout android:id="@+id/row_ai" style="@style/SettingRow">
            <TextView style="@style/SettingLabel" android:text="@string/ai_config"/>
            <TextView android:id="@+id/val_ai" style="@style/SettingValue"/>
            <TextView style="@style/SettingChevron"/>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/settings_group_build" android:textSize="12sp"
            android:textColor="#FF5F6368" android:layout_marginTop="16dp"
            android:layout_marginStart="8dp"/>
        <LinearLayout android:id="@+id/row_sign" style="@style/SettingRow">
            <TextView style="@style/SettingLabel" android:text="@string/sign_title"/>
            <TextView android:id="@+id/val_sign" style="@style/SettingValue"/>
            <TextView style="@style/SettingChevron"/>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/settings_group_theme" android:textSize="12sp"
            android:textColor="#FF5F6368" android:layout_marginTop="16dp"
            android:layout_marginStart="8dp"/>
        <LinearLayout android:id="@+id/row_theme" style="@style/SettingRow">
            <TextView style="@style/SettingLabel" android:text="@string/theme_title"/>
            <TextView android:id="@+id/val_theme" style="@style/SettingValue"/>
            <TextView style="@style/SettingChevron"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/row_color" style="@style/SettingRow">
            <TextView style="@style/SettingLabel" android:text="@string/accent_title"/>
            <TextView android:id="@+id/val_color" style="@style/SettingValue"/>
            <TextView style="@style/SettingChevron"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/row_bg" style="@style/SettingRow">
            <TextView style="@style/SettingLabel" android:text="@string/bg_title"/>
            <TextView android:id="@+id/val_bg" style="@style/SettingValue"/>
            <TextView style="@style/SettingChevron"/>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/settings_group_lang" android:textSize="12sp"
            android:textColor="#FF5F6368" android:layout_marginTop="16dp"
            android:layout_marginStart="8dp"/>
        <LinearLayout android:id="@+id/row_lang" style="@style/SettingRow">
            <TextView style="@style/SettingLabel" android:text="@string/lang_title"/>
            <TextView android:id="@+id/val_lang" style="@style/SettingValue"/>
            <TextView style="@style/SettingChevron"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/row_update" style="@style/SettingRow">
            <TextView style="@style/SettingLabel" android:text="@string/check_update"/>
            <TextView style="@style/SettingChevron"/>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/settings_group_about" android:textSize="12sp"
            android:textColor="#FF5F6368" android:layout_marginTop="16dp"
            android:layout_marginStart="8dp"/>
        <LinearLayout style="@style/SettingRowNoArrow">
            <TextView style="@style/SettingLabel" android:text="@string/version"/>
        </LinearLayout>
        <LinearLayout style="@style/SettingRowNoArrow">
            <TextView style="@style/SettingLabel" android:text="@string/developer"/>
        </LinearLayout>
        <LinearLayout style="@style/SettingRowNoArrow">
            <TextView android:id="@+id/tv_grade" style="@style/SettingLabel"
                android:textColor="#FF1F6FEB"/>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="EOST Packer · 真实打包 / 签名 / 加固"
            android:textSize="11sp" android:textColor="#FF9AA0A6"
            android:gravity="center" android:layout_marginTop="24dp"
            android:layout_marginBottom="20dp"/>
    </LinearLayout>
</ScrollView>
